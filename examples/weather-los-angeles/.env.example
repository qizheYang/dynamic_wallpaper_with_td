# Proposed developer configuration; no loader exists yet. See README.md.
# Copy to a local .env only when implementing the connector. Never source it as code.
# Choose one verified provider adapter and model; credentials stay out of prompts/bundles.
WALLPAPER_AGENT_PROVIDER=
WALLPAPER_AGENT_BASE_URL=
WALLPAPER_AGENT_MODEL=
WALLPAPER_AGENT_API_KEY=

# Personal-development weather example. Commercial use requires a suitable plan/provider.
WALLPAPER_WEATHER_PROVIDER=open-meteo
WALLPAPER_WEATHER_BASE_URL=https://api.open-meteo.com
WALLPAPER_WEATHER_API_KEY=
WALLPAPER_WEATHER_LATITUDE=34.0522
WALLPAPER_WEATHER_LONGITUDE=-118.2437
WALLPAPER_WEATHER_TIMEZONE=America/Los_Angeles
WALLPAPER_WEATHER_REFRESH_SECONDS=900
